  <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 16 }} />

  <Box style={{ flexDirection: 'row', marginTop: 32, gap: 28, flex: 1 }}>
    <Box style={{ width: '34%', background: '#2563EB', borderRadius: 12, padding: 32, justifyContent: 'center' }}>
      <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
      <Text style={{ fontSize: 22, color: '#DBEAFE', marginTop: 12 }}>为什么做这个题目</Text>
