<Slide style={{ padding: 60, fontFamily: '"Microsoft YaHei", Arial, sans-serif', background: '#FFFFFF' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
    <Box style={{ width: 6, height: 34, background: '#2563EB', borderRadius: 3 }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1E293B' }}>核心功能演示 · 课程 / 成绩 / 统计</Text>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#E2E8F0', marginTop: 16 }} />

  <Box style={{ flexDirection: 'row', gap: 20, marginTop: 30, flex: 1 }}>
    <Box style={{ flex: 1, borderRadius: 12, overflow: 'hidden', border: '1px solid #E2E8F0' }}>
      <Image src="assets/screen_course.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
      <Text style={{ fontSize: 16, color: '#64748B', textAlign: 'center', padding: 8, background: '#F8FAFC' }}>课程管理</Text>
    </Box>
    <Box style={{ flex: 1, borderRadius: 12, overflow: 'hidden', border: '1px solid #E2E8F0' }}>
      <Image src="assets/screen_score.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
      <Text style={{ fontSize: 16, color: '#64748B', textAlign: 'center', padding: 8, background: '#F8FAFC' }}>成绩管理</Text>
    </Box>
    <Box style={{ flex: 1, borderRadius: 12, overflow: 'hidden', border: '1px solid #E2E8F0' }}>
      <Image src="assets/screen_stat.png" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
      <Text style={{ fontSize: 16, color: '#64748B', textAlign: 'center', padding: 8, background: '#F8FAFC' }}>统计报表</Text>
    </Box>
  </Box>
  <Box style={{ background: '#1E293B', borderRadius: 10, padding: 18, marginTop: 24 }}>
    <Text style={{ fontSize: 18, color: '#FFFFFF' }}>成绩页关联展示学生姓名与课程名称；统计页给出平均分排名与课程及格率等聚合结果。</Text>
  </Box>

  <Box style={{ position: 'absolute', bottom: 30, left: 60, right: 60, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>学生成绩管理系统 · 课程设计汇报</Text>
    <Text style={{ fontSize: 14, color: '#94A3B8' }}>09 / 12</Text>
  </Box>
</Slide>
