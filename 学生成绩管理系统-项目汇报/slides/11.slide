    <Box style={{ flex: 1, background: '#EFF6FF', borderRadius: 12, padding: 26, border: '1px solid #BFDBFE' }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2563EB' }}>可扩展方向</Text>
